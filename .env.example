# Aplikacja
ENVIRONMENT=development
FRONTEND_ORIGINS=http://localhost:5173
JWT_SECRET_KEY=zamien-na-dlugi-losowy-sekret-minimum-32-znaki
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Baza: lokalnie SQLite, produkcyjnie Neon PostgreSQL
DATABASE_URL=sqlite:///./promptforge.db
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Dostawcy AI — nigdy nie umieszczaj kluczy w kodzie ani w repozytorium
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Wysyłka e-maili (reset hasła)
FRONTEND_URL=http://localhost:5173
# Zalecane na Render: Brevo przez HTTPS (działa na darmowym planie Render)
BREVO_API_KEY=
EMAIL_FROM=no-reply@twoja-domena.pl
EMAIL_FROM_NAME=PromptForge AI
# Alternatywa tylko dla środowiska lokalnego / hostingu z dostępnym SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
